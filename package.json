{
  "name": "rehype-resolve-markdown-links-monorepo",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm run lint:eslint && pnpm run lint:knip",
    "lint:eslint": "eslint",
    "lint:knip": "knip",
    "fix": "pnpm run fix:oxfmt && pnpm run fix:eslint",
    "fix:eslint": "eslint --fix .",
    "fix:oxfmt": "oxfmt",
    "test": "vitest",
    "typecheck": "tsc -b"
  },
  "peerDependencies": {
    "satteri": "^0.7.0"
  },
  "peerDependenciesMeta": {
    "satteri": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ocavue/eslint-config": "^4.5.9",
    "@ocavue/tsconfig": "^0.7.1",
    "@types/node": "^22.19.11",
    "eslint": "^10.4.1",
    "knip": "^6.15.0",
    "oxfmt": "^0.53.0",
    "rehype-resolve-markdown-links": "workspace:*",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "satteri": "^0.8.0",
    "satteri-resolve-markdown-links": "workspace:*",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
